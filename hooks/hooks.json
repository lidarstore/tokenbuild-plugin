{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Read|Grep|Glob|Bash|Edit|MultiEdit|Write", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/tokenbuild.mjs", "guard"], "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|TodoWrite", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/tokenbuild.mjs", "hook", "post"], "timeout": 10 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/tokenbuild.mjs", "hook", "post"], "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/tokenbuild.mjs", "hook", "prompt"], "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/tokenbuild.mjs", "hook", "stop"], "timeout": 120 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/tokenbuild.mjs", "hook", "start"], "timeout": 10 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/tokenbuild.mjs", "hook", "precompact"], "timeout": 10 }] }
    ]
  }
}
